{
  "name": "andromon",
  "productName": "Andromon",
  "version": "1.0.5",
  "description": "Android phone manager for Windows, macOS and Linux (ADB over USB)",
  "license": "GPL-3.0-only",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build:renderer": "esbuild src/app.js --bundle --format=esm --target=chrome120 --minify --sourcemap --outfile=renderer/app.js",
    "start": "npm run build:renderer && electron .",
    "web": "npm run build:renderer && python3 -m http.server 8000 --bind 127.0.0.1 --directory renderer",
    "build:web": "npm run build:renderer && node scripts/build-web.js",
    "dist:mac": "npm run build:renderer && electron-builder --mac",
    "dist:win": "npm run build:renderer && electron-builder --win",
    "dist:linux": "npm run build:renderer && electron-builder --linux",
    "build:uihelper": "sh uihelper/build.sh",
    "build:companion": "cd ../android && ./gradlew assembleRelease -q && cp app/build/outputs/apk/release/app-release.apk ../pc/renderer/companion.apk"
  },
  "devDependencies": {
    "@yume-chan/adb": "2.6.4",
    "@yume-chan/adb-credential-web": "2.1.0",
    "@yume-chan/adb-daemon-webusb": "2.3.2",
    "@yume-chan/adb-scrcpy": "2.3.2",
    "@yume-chan/scrcpy": "2.3.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "2.5.3",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "leaflet": "1.9.4",
    "mediabunny": "1.62.0",
    "qrcode-generator": "1.4.4"
  },
  "build": {
    "appId": "dev.andromon.app",
    "productName": "Andromon",
    "files": [
      "main.js",
      "preload.js",
      "LICENSE",
      "localsend.js",
      "netlink.js",
      "wadb.js",
      "inspector.js",
      "apiclient.js",
      "traceview.js",
      "backupfs.js",
      "revanced.js",
      "fdroid.js",
      "appsettings.js",
      "updater.js",
      "build-info.json",
      "requirements.js",
      "recovery.js",
      "renderer/**/*",
      "!renderer/*.map"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSUserNotificationAlertStyle": "alert"
      },
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Andromon",
      "uninstallDisplayName": "Andromon",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Andromon-Setup-${version}-${arch}.${ext}"
    },
    "artifactName": "Andromon-${version}-${arch}.${ext}",
    "copyright": "Andromon",
    "dmg": {
      "title": "Install ${productName}",
      "background": "build/background.png",
      "iconSize": 96,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 200
        },
        {
          "x": 390,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "executableName": "andromon",
      "synopsis": "Android phone manager",
      "maintainer": "Deshan555 <Deshan555@users.noreply.github.com>",
      "syncDesktopName": true
    },
    "deb": {
      "recommends": [
        "default-jre",
        "android-sdk-platform-tools-common"
      ]
    }
  },
  "homepage": "https://github.com/Deshan555/Andromon_PC",
  "desktopName": "andromon.desktop"
}
